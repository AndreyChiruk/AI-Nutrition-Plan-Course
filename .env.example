# Пример конфигурации. Скопируйте в .env и заполните своими значениями.
# ВАЖНО: файл .env в git не попадает (см. .gitignore). Реальные ключи здесь хранить нельзя.

PORT=3000

# --- Безопасность ---
# Обязателен. Сгенерировать: openssl rand -hex 32
# Приложение не должно запускаться со значением по умолчанию.
JWT_SECRET=

# --- База данных (для локального запуска без Docker) ---
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=course

# --- SMTP (коды подтверждения) ---
# Для Gmail нужен пароль приложения, а не пароль от аккаунта.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your@gmail.com
# true возвращает код подтверждения прямо в ответе API. Только для локальной отладки!
MAIL_DEBUG=false

# --- OpenRouter (основной AI-провайдер) ---
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Адрес шлюза. Менять нужно только при использовании прокси.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Адрес приложения — уходит в HTTP-Referer для статистики OpenRouter.
APP_URL=https://localhost

# Модели задаются в формате «провайдер/модель».
# Список доступных: https://openrouter.ai/models
# Если оставить пустыми — используется openai/gpt-4o-mini.
AI_MODEL_FOOD_RECOGNITION=openai/gpt-4o-mini
AI_MODEL_PLAN_GENERATION=openai/gpt-4o-mini
AI_MODEL_BODY_ANALYSIS=openai/gpt-4o-mini
AI_MODEL_RECOMMENDATIONS=openai/gpt-4o-mini
AI_MODEL_CHAT=openai/gpt-4o-mini
AI_MODEL_IMAGE=google/gemini-3.1-flash-image

# Общие параметры запросов
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_TOKENS=700
OPENAI_REFINEMENT_MAX_TOKENS=40000

# --- Устаревшее: OpenAI напрямую больше не используется ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_USAGE_ADMIN_KEY=
# OPENAI_ORGANIZATION_ID=

# --- Первичный администратор ---
# Создаётся только при первом старте на пустой БД. Пароль обязательно сменить после входа.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Лимит тела HTTP-запроса (фотографии нормализуются до 8 МБ на сервере).
JSON_BODY_LIMIT=12mb

# --- Stripe (подписка, только тестовый режим) ---
# Ключи: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here
# Секрет вебхука. API опубликован на 127.0.0.1:3000 (только loopback),
# поэтому команда запускается так:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here
# Идентификатор цены подписки: stripe prices create --unit-amount=990 --currency=usd \
#   --product=<prod_id> --recurring.interval=month
STRIPE_PRICE_ID_MONTHLY=price_your-price-here

# Цена для отображения в интерфейсе (подставляется при сборке фронтенда).
VITE_SUBSCRIPTION_PRICE=9.90 $
