# Переменные окружения фронтенда.
#
# ВАЖНО: значения VITE_* подставляются во время сборки (`npm run build`)
# и попадают прямо в JS-бандл. После изменения переменной нужно
# пересобрать проект — «на лету», как на сервере, они не читаются.

# Адрес API. Префикс /api обязателен: без него запросы уйдут не туда
# и вернут 404 (так ломался вход в систему).
#
# Если фронтенд отдаёт Nginx и проксирует /api на backend, переменную
# можно не задавать вовсе — используется относительный путь /api.
# Явный адрес нужен при отдельном хостинге фронтенда, например на Vercel.
VITE_API_BASE_URL=https://ваш-api-домен/api

# Цена подписки для отображения. Реальная сумма списывается Stripe,
# здесь только подпись в карточке подписки.
VITE_SUBSCRIPTION_PRICE=9.90 $
