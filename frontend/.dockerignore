# .dockerignore для web-сборки (docker/nginx/Dockerfile).
#
# Файл действует на содержимое frontend/ и читается при
# `COPY frontend/ ./`. Корневой .dockerignore его не заменяет —
# правила складываются: сначала корневые, затем эти.
#
# Раньше этого файла не было, и в контекст web-сборки уезжала
# вся папка frontend целиком.

# Зависимости и артефакты сборки — ставятся внутри образа заново.
node_modules
dist
build

# Локальные кэши и логи.
.vite
*.log
npm-debug.log*

# Тесты и покрытие.
coverage
.nyc_output

# Локальные переменные окружения.
.env
.env.*

# Файлы IDE и ОС.
.DS_Store
.idea
.vscode
*.swp

# Документация.
*.md
