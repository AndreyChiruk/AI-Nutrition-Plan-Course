{
  "name": "course",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"src/tests/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node ./scripts/check-node-version.cjs && mocha --require ./scripts/mocha-register.cjs --extension ts --recursive src/tests/unit",
    "test:integration": "node ./scripts/check-node-version.cjs && mocha --require ./scripts/mocha-register.cjs --extension ts --timeout 120000 src/tests/integration/api-smoke.integration.ts",
    "test:coverage": "node ./scripts/check-node-version.cjs && nyc --reporter=text --reporter=text-summary --extension .ts mocha --require ./scripts/mocha-register.cjs --extension ts --recursive src/tests/unit",
    "test:load:k6": "echo Install k6 from https://k6.io/docs/get-started/installation/ then: k6 run scripts/load/k6-api.js",
    "catalog:themealdb": "ts-node --transpile-only src/cli/themealdb-replace-catalog.ts",
    "repair:mojibake": "ts-node --transpile-only src/cli/repair-mojibake.ts",
    "repair:mojibake:dry": "ts-node --transpile-only src/cli/repair-mojibake.ts --dry-run",
    "fix:catalog-nutrition": "ts-node --transpile-only src/cli/fix-catalog-nutrition.ts",
    "fix:catalog-nutrition:dry": "ts-node --transpile-only src/cli/fix-catalog-nutrition.ts --dry-run",
    "backfill:catalog-tags": "ts-node --transpile-only src/cli/backfill-catalog-tags.ts",
    "backfill:catalog-tags:dry": "ts-node --transpile-only src/cli/backfill-catalog-tags.ts --dry-run",
    "recalc:plan-totals": "ts-node --transpile-only src/cli/recalc-plan-totals.ts",
    "recalc:plan-totals:dry": "ts-node --transpile-only src/cli/recalc-plan-totals.ts --dry-run",
    "check:node": "node ./scripts/check-node-version.cjs",
    "docs:api": "ts-node --transpile-only src/cli/generate-api-docs.ts",
    "import:cis-dishes": "ts-node --transpile-only src/cli/import-cis-dishes.ts",
    "import:cis-dishes:dry": "ts-node --transpile-only src/cli/import-cis-dishes.ts --dry-run",
    "normalize:portions": "ts-node --transpile-only src/cli/normalize-portions.ts",
    "normalize:portions:dry": "ts-node --transpile-only src/cli/normalize-portions.ts --dry-run"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@types/multer": "^2.3.0",
    "cache-manager": "^7.2.8",
    "dotenv": "^17.4.1",
    "multer": "^2.4.0",
    "nodemailer": "^8.0.5",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.34.5",
    "stripe": "^23.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.0",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "chai": "^4.5.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "mocha": "^10.8.2",
    "nyc": "^18.0.0",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
